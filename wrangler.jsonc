// O SITE NA CLOUDFLARE (quando houver domínio): um Worker com os ficheiros que o build escreve em
// _site/. Ainda NÃO se publicou nada (16 nov 2026): falta o domínio, e o site só abre aos motores de
// busca com os dados legais preenchidos (node scripts/build.mjs --producao pára sem eles).
//
// PORQUÊ UM WORKER: os termos do GitHub Pages proíbem usá-lo para uma loja online («not intended for
// or allowed to be used … to run your online business, e-commerce site»).
//
// Quando houver domínio: escrevê-lo em scripts/build.mjs e em worker/www.js (DOMINIO), acrescentar
// aqui as rotas, uma por linha:
//   "routes": [{ "pattern": "<domínio>", "custom_domain": true }, { "pattern": "www.<domínio>", "custom_domain": true }],
// construir com --producao e publicar a partir desta pasta (wrangler deploy --config ./wrangler.jsonc).
// Os comentários são linhas inteiras.
{
  "name": "flores-essencias-site",
  "compatibility_date": "2026-09-01",
  "main": "worker/www.js",
  "assets": {
    "directory": "./_site",
    "binding": "ASSETS",
    // O script corre primeiro em todos os pedidos: manda o www para o domínio sem www e responde aos
    // vídeos por intervalos (o iPhone); o resto passa logo para os ficheiros.
    "run_worker_first": true,
    // Uma morada que não existe mostra a 404.html do site.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "workers_dev": false,
  "preview_urls": false
}
